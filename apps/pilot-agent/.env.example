# Copy to repo root .env OR apps/pilot-agent/.env — all values from Aegis Console (http://localhost:3000)

AEGIS_API_URL=http://127.0.0.1:8080

# Console → API keys → Create → copy secret once
AEGIS_INGEST_API_KEY=

# Console → Settings → Organization → Organization ID
AEGIS_ORGANIZATION_ID=

# Console → Agents → Create agent → credentials JSON
AEGIS_AGENT_ID=
AEGIS_KEY_ID=
AEGIS_SIGNING_PRIVATE_KEY_B64=

# Optional
# AEGIS_ORGANIZATION_SLUG=your-org-slug
# GEMINI_API_KEY=
