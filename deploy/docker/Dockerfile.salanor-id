# Salanor ID - Railway / Fly (no build args required)
# Railway: Dockerfile path = deploy/docker/Dockerfile.salanor-id
# Runs as the unprivileged `node` user.
#
# Includes compiled demo-tools so Platform Ops → Demo data → Populate can spawn
# provision-demo-tenant / seed-history without tsx (see runDemoCli in platform.ts).
# Still needs DEMO_TENANT_FILE (or a mounted tenant JSON) + PLATFORM_BOOTSTRAP_SECRET
# on the service for those CLIs to succeed.

FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY services ./services
COPY sdks ./sdks
COPY tools ./tools

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @salanor/platform-auth build && \
    pnpm --filter @salanor/observability build && \
    pnpm --filter @salanor/aegis build && \
    pnpm --filter @salanor/aegis-sdk build && \
    pnpm --filter @salanor/aegis-connector build

RUN pnpm --filter id build && \
    pnpm --filter @salanor/demo-tools build

FROM node:22-bookworm-slim

ENV NODE_ENV=production
# Ops Populate / seed-history write Connector keys here (image /app is often not writable).
ENV AEGIS_CONNECTORS_DIR=/tmp/salanor-demo-connectors

WORKDIR /app/services/id

COPY --from=build --chown=node:node /app /app

RUN mkdir -p /tmp/salanor-demo-connectors && chown node:node /tmp/salanor-demo-connectors

USER node

EXPOSE 8091

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8091)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
