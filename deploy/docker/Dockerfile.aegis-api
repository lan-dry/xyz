# Aegis API - Railway / Fly (no build args required)
# Railway: Dockerfile path = deploy/docker/Dockerfile.aegis-api
# Runs as the unprivileged `node` user. Migrations run as a release step
# (see services/aegis-api/railway.toml preDeployCommand), never at container start.
#
# Admin CLIs (compiled JS) for the Railway console:
#   node /app/tools/demo/dist/provision-demo-tenant.mjs
#   node /app/tools/demo/dist/seed-history.mjs
#   node /app/tools/demo/dist/wipe-tenant.mjs --slug <slug>
#   node /app/tools/demo/dist/demo-fresh.mjs
#   node /app/services/aegis-api/dist/packs/apply-pack-cli.js --pack banking --org <uuid>

FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY services ./services
COPY sdks ./sdks
COPY tools ./tools

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @salanor/platform-auth build && \
    pnpm --filter @salanor/observability build && \
    pnpm --filter @salanor/aegis build && \
    pnpm --filter @salanor/witness-merkle build

RUN pnpm --filter aegis-api build && \
    pnpm --filter @salanor/demo-tools build

FROM node:22-bookworm-slim

ENV NODE_ENV=production

WORKDIR /app/services/aegis-api

COPY --from=build --chown=node:node /app /app

USER node

EXPOSE 8080

# Liveness only (process + HTTP). Readiness (database) is /ready; Railway uses /health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
