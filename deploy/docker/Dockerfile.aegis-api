# Aegis API — Railway / Fly (no build args required)
# Railway: Dockerfile path = deploy/docker/Dockerfile.aegis-api

FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY services ./services
COPY sdks ./sdks

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @salanor/platform-auth build && \
    pnpm --filter @salanor/observability build && \
    pnpm --filter @salanor/aegis build && \
    pnpm --filter @salanor/witness-merkle build

RUN pnpm --filter aegis-api build

FROM node:22-bookworm-slim

ENV NODE_ENV=production

WORKDIR /app/services/aegis-api

COPY --from=build /app /app

CMD ["node", "dist/index.js"]
