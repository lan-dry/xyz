# Bank simulator ("Simulated core banking system") - Railway
# Railway: Dockerfile path = deploy/docker/Dockerfile.bank-simulator, Root Directory = repo root
# Runs as the unprivileged `node` user. Needs BANK_SIMULATOR_PASS, AEGIS_API_BASE, AEGIS_INGEST_KEY
# (server-side only). Full runbook: docs/DEPLOY_PRODUCTION.md

FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY sdks ./sdks
COPY tools/bank-simulator ./tools/bank-simulator

RUN pnpm install --frozen-lockfile --filter @salanor/bank-simulator...

# SDK + connector are used for signed story ingest / unreachable buffer.
RUN pnpm --filter @salanor/aegis build && \
    pnpm --filter @salanor/aegis-sdk build && \
    pnpm --filter @salanor/aegis-connector build

FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV BANK_SIMULATOR_DATA_DIR=/data
ENV BANK_SIMULATOR_TRUST_PROXY=1

WORKDIR /app/tools/bank-simulator

COPY --from=build --chown=node:node /app /app
RUN mkdir -p /data && chown node:node /data \
  && apt-get update \
  && apt-get install -y --no-install-recommends gosu \
  && rm -rf /var/lib/apt/lists/*

COPY deploy/docker/bank-simulator-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Start as root so the entrypoint can chown a Railway volume at /data, then drop to node.
USER root

EXPOSE 4000

# Liveness only. /health returns no data and needs no login.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "server.mjs"]
