# Shared production image for Salanor Node backend services (pnpm monorepo).
# Build args:
#   SERVICE_FILTER   pnpm filter name (e.g. aegis-api, id, billing, insurance-api)
#   START_COMMAND    process command (e.g. pnpm --filter aegis-api start)
#   WITNESS_BUILD    set to 1 when building aegis-api or worker apps

FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY services ./services
COPY sdks ./sdks

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @salanor/platform-auth build && \
    pnpm --filter @salanor/observability build && \
    pnpm --filter @salanor/aegis build

ARG WITNESS_BUILD=0
RUN if [ "$WITNESS_BUILD" = "1" ]; then pnpm --filter @salanor/witness-merkle build; fi

ARG SERVICE_FILTER=id
RUN pnpm --filter "${SERVICE_FILTER}" build

FROM node:22-bookworm-slim

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY --from=build /app /app

ARG START_COMMAND=pnpm --filter id start
ENV START_COMMAND=${START_COMMAND}

CMD ["sh", "-c", "${START_COMMAND}"]
