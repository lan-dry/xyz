{
  "name": "stoa-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stoa — governed AI gateway, threads, DLP, audit",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "retention:scheduled": "tsx src/db/retention-cli.ts",
    "db:seed:dev": "tsx src/db/seed-dev-cli.ts",
    "eval:detection": "tsx scripts/eval-detection.mts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@salanor/db-url": "workspace:*",
    "@salanor/observability": "workspace:*",
    "@salanor/platform-auth": "workspace:*",
    "@workos-inc/node": "^7.41.0",
    "dotenv": "^16.4.7",
    "hono": "^4.7.11",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@salanor/config": "workspace:*",
    "@types/node": "^22.15.21",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.4",
    "@types/sharp": "^0.32.0",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.4"
  },
  "nx": {
    "tags": [
      "type:service",
      "scope:stoa"
    ]
  }
}
