{
  "id": "demo.banking",
  "name": "Demo banking pack (illustrative retail lending)",
  "demo_only": true,
  "sector": "banking",
  "version": 6,
  "combine": "all_matching",
  "currencies": [
    "RWF"
  ],
  "roles": [
    {
      "role_key": "credit_officer",
      "display_name": "Credit Officer",
      "level": 10
    },
    {
      "role_key": "credit_manager",
      "display_name": "Credit Manager",
      "level": 20
    },
    {
      "role_key": "compliance_officer",
      "display_name": "Compliance Officer",
      "level": 25
    },
    {
      "role_key": "fraud_analyst",
      "display_name": "Fraud Analyst",
      "level": 28
    },
    {
      "role_key": "dpo",
      "display_name": "Data Protection Officer",
      "level": 30
    },
    {
      "role_key": "head_of_compliance",
      "display_name": "Head of Compliance",
      "level": 40
    }
  ],
  "segment_product_limits": [
    {
      "segment": "retail_standard",
      "product": "payment_transfer",
      "label": "Retail Standard",
      "window_hours": 24,
      "max_amount": 8000000,
      "max_count": 10
    },
    {
      "segment": "retail_standard",
      "product": "retail_loan",
      "label": "Retail Standard",
      "window_hours": 24,
      "max_amount": 25000000,
      "max_count": 5
    },
    {
      "segment": "private_banking",
      "product": "payment_transfer",
      "label": "Private Banking",
      "window_hours": 24,
      "max_amount": 50000000,
      "max_count": 40
    }
  ],
  "authority_matrix": [
    {
      "matrix_id": "demo_banking_rl_low",
      "product": "retail_loan",
      "amount_min": 0,
      "amount_max": 5000000,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": null,
      "outcome": "allow",
      "rule_code": "AUTH-RL-1",
      "active": true
    },
    {
      "matrix_id": "demo_banking_rl_mid",
      "product": "retail_loan",
      "amount_min": 5000000,
      "amount_max": 20000000,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": "credit_manager",
      "outcome": "hold",
      "rule_code": "AUTH-RL-2",
      "active": true
    },
    {
      "matrix_id": "demo_banking_rl_high",
      "product": "retail_loan",
      "amount_min": 20000000,
      "amount_max": null,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": "credit_manager",
      "outcome": "hold",
      "rule_code": "AUTH-RL-HIGH",
      "active": true
    },
    {
      "matrix_id": "demo_banking_xfer_low",
      "product": "payment_transfer",
      "amount_min": 0,
      "amount_max": 5000000,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": null,
      "outcome": "allow",
      "rule_code": "AUTH-XFER-1",
      "active": true
    },
    {
      "matrix_id": "demo_banking_xfer_mid",
      "product": "payment_transfer",
      "amount_min": 5000000,
      "amount_max": 20000000,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": "credit_manager",
      "outcome": "hold",
      "rule_code": "AUTH-XFER-2",
      "active": true
    }
  ],
  "field_policies": [
    {
      "field_path": "national_id",
      "mode": "mask",
      "mask_keep_last": 4
    },
    {
      "field_path": "applicant_name",
      "mode": "mask",
      "mask_keep_last": 0
    }
  ],
  "rules": [
    {
      "rule_id": "AUTH-RL-1",
      "tool_pattern": "governed.action",
      "decision": "allow",
      "priority": 10
    },
    {
      "rule_id": "VEL-SEG-DAY",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 70,
      "conditions": {
        "expr": {
          "or": [
            { "eq": ["aegis.exceeds_segment_daily_amount", true] },
            { "eq": ["aegis.exceeds_segment_daily_count", true] }
          ]
        }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": ["reason_code", "comment"]
      }
    },
    {
      "rule_id": "BEN-NEW-OFF",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 65,
      "conditions": {
        "expr": {
          "and": [
            { "eq": ["aegis.new_beneficiary", true] },
            { "gte": ["amount", 5000000] },
            { "eq": ["aegis.time_of_day", "off_hours"] }
          ]
        }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": ["reason_code", "comment"]
      }
    },
    {
      "rule_id": "CHN-AGT",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 45,
      "conditions": {
        "expr": {
          "and": [
            { "in": ["aegis.channel", ["agent", "ussd"]] },
            { "gte": ["amount", 5000000] },
            { "eq": ["aegis.time_of_day", "off_hours"] }
          ]
        }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": ["reason_code", "comment"]
      }
    },
    {
      "rule_id": "FRD-SCORE-RET",
      "tool_pattern": "governed.action",
      "decision": "deny",
      "priority": 95,
      "conditions": {
        "hard_stop": true,
        "expr": {
          "and": [
            { "eq": ["aegis.segment", "retail_standard"] },
            { "gte": ["model.score", 0.9] }
          ]
        }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "fraud_analyst",
        "release_requires_role": "fraud_analyst",
        "required_fields": ["reason_code", "comment"]
      }
    },
    {
      "rule_id": "LN-07",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 50,
      "conditions": {
        "expr": {
          "and": [
            { "gt": ["model.score", 0.7] },
            { "lt": ["model.score", 0.9] }
          ]
        }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": [
          "reason_code",
          "comment"
        ]
      }
    },
    {
      "rule_id": "SANC-01",
      "tool_pattern": "governed.action",
      "decision": "deny",
      "priority": 100,
      "conditions": {
        "hard_stop": true,
        "expr": {
          "or": [
            {
              "eq": [
                "screening.sanctions_hit",
                true
              ]
            },
            {
              "eq": [
                "screening.pep_hit",
                true
              ]
            }
          ]
        }
      }
    },
    {
      "rule_id": "PAY-03",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 60,
      "conditions": {
        "expr": {
          "eq": [
            "payment.callback_verified",
            false
          ]
        }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": [
          "callback_verified"
        ]
      }
    },
    {
      "rule_id": "PAY-OVERRIDE",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 80,
      "conditions": {
        "expr": { "eq": ["requested_override", true] }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": ["reason_code", "comment"]
      }
    },
    {
      "rule_id": "PAY-ALTER",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 82,
      "conditions": {
        "expr": { "eq": ["payment_altered", true] }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": ["reason_code", "comment"]
      }
    },
    {
      "rule_id": "PAY-SPLIT",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 83,
      "conditions": {
        "expr": { "eq": ["split_payment", true] }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": ["reason_code", "comment"]
      }
    }
  ],
  "workflows": [
    {
      "name": "Retail loan decision",
      "product": "retail_loan",
      "record_only": false,
      "on_unreachable": "hold",
      "executable_params": [
        "amount",
        "currency",
        "beneficiary_account",
        "product"
      ],
      "execution_control": "enforce",
      "on_aegis_unavailable": "allow_and_flag",
      "action_type": "loan.disburse",
      "token_ttl_sec": 3600,
      "required_grade": "G2",
      "on_missing": "exception",
      "grade_deadline_hours": 24
    },
    {
      "name": "Payment transfer",
      "product": "payment_transfer",
      "record_only": false,
      "on_unreachable": "hold",
      "executable_params": [
        "amount",
        "currency",
        "beneficiary_account",
        "product"
      ],
      "execution_control": "enforce",
      "on_aegis_unavailable": "allow_and_flag",
      "action_type": "payment.transfer",
      "token_ttl_sec": 3600,
      "required_grade": "G2",
      "on_missing": "exception",
      "grade_deadline_hours": 24
    }
  ],
  "labels": {
    "rule_titles": {
      "AUTH-RL-1": "Within officer limit",
      "AUTH-RL-2": "Above officer limit",
      "AUTH-RL-HIGH": "Above manager band",
      "AUTH-XFER-1": "Within transfer officer limit",
      "AUTH-XFER-2": "Above transfer officer limit",
      "VEL-SEG-DAY": "Segment daily limit (Aegis-reported)",
      "BEN-NEW-OFF": "New beneficiary off-hours",
      "CHN-AGT": "Agent or USSD off-hours",
      "FRD-SCORE-RET": "Retail fraud score hard stop",
      "LN-07": "High model score requires Credit Manager",
      "PAY-03": "Payment callback verification",
      "PAY-OVERRIDE": "Requested override",
      "PAY-ALTER": "Altered payment",
      "PAY-SPLIT": "Split payment",
      "SANC-01": "Sanctions / PEP hard stop"
    },
    "role_labels": {
      "credit_officer": "Credit Officer",
      "credit_manager": "Credit Manager",
      "compliance_officer": "Compliance Officer",
      "fraud_analyst": "Fraud Analyst",
      "head_of_compliance": "Head of Compliance",
      "dpo": "DPO"
    },
    "product_labels": {
      "retail_loan": "Loan disbursement",
      "payment_transfer": "Payment transfer"
    },
    "event_type_labels": {
      "loan_decision": "Loan disbursement",
      "loan_disbursement": "Loan disbursement",
      "payment_transfer": "Payment transfer"
    }
  }
}
