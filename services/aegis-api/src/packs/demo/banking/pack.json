{
  "id": "demo.banking",
  "name": "Demo banking pack (illustrative retail lending)",
  "demo_only": true,
  "sector": "banking",
  "version": 1,
  "combine": "all_matching",
  "currencies": ["RWF"],
  "roles": [
    { "role_key": "credit_officer", "display_name": "Credit Officer", "level": 10 },
    { "role_key": "credit_manager", "display_name": "Credit Manager", "level": 20 },
    { "role_key": "compliance_officer", "display_name": "Compliance Officer", "level": 25 },
    { "role_key": "dpo", "display_name": "Data Protection Officer", "level": 30 },
    { "role_key": "head_of_compliance", "display_name": "Head of Compliance", "level": 40 }
  ],
  "authority_matrix": [
    {
      "matrix_id": "demo_banking_rl_low",
      "product": "retail_loan",
      "amount_min": 0,
      "amount_max": 5000000,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": null,
      "outcome": "allow",
      "rule_code": "AUTH-RL",
      "active": true
    },
    {
      "matrix_id": "demo_banking_rl_mid",
      "product": "retail_loan",
      "amount_min": 5000000,
      "amount_max": 20000000,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": "credit_manager",
      "outcome": "hold",
      "rule_code": "AUTH-RL",
      "active": true
    },
    {
      "matrix_id": "demo_banking_rl_high",
      "product": "retail_loan",
      "amount_min": 20000000,
      "amount_max": null,
      "currency": "RWF",
      "risk_tier": null,
      "required_role": "credit_manager",
      "outcome": "hold",
      "rule_code": "AUTH-RL-HIGH",
      "active": true
    }
  ],
  "field_policies": [
    { "field_path": "national_id", "mode": "mask", "mask_keep_last": 4 }
  ],
  "rules": [
    {
      "rule_id": "AUTH-RL",
      "tool_pattern": "governed.action",
      "decision": "allow",
      "priority": 10
    },
    {
      "rule_id": "LN-07",
      "tool_pattern": "governed.action",
      "decision": "allow_with_obligation",
      "priority": 50,
      "conditions": { "expr": { "gt": ["model.score", 0.7] } },
      "obligations": {
        "kind": "human_approval",
        "required_role": "credit_manager",
        "required_fields": ["reason_code", "comment"]
      }
    }
  ],
  "workflows": [
    {
      "name": "Retail loan decision",
      "product": "retail_loan",
      "record_only": false,
      "on_unreachable": "hold"
    }
  ]
}
