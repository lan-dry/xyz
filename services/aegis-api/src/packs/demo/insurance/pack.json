      "priority": 80,
      "conditions": {
        "expr": { "eq": ["claimant.is_staff", true] }
      },
      "obligations": {
        "kind": "human_approval",
        "required_role": "fraud_analyst",
        "required_fields": ["reason_code", "comment"]
      }
    },
    {
      "rule_id": "CLM-01",
      "tool_pattern": "governed.action",
      "decision": "allow",
      "priority": 10
    }
  ],
  "workflows": [
    {
      "name": "Claim payout",
      "product": "claim_payout",
      "record_only": false,
      "on_unreachable": "hold"
    }
  ]
