      "active": true
    },
    {
      "matrix_id": "demo_ins_claim_mid",
      "product": "claim_payout",
      "amount_min": 2500,
      "amount_max": 25000,
      "currency": "EUR",
      "risk_tier": null,
      "required_role": "claims_supervisor",
      "outcome": "hold",
      "rule_code": "CLM-02",
      "active": true
    },
    {
      "matrix_id": "demo_ins_claim_high",
      "product": "claim_payout",
      "amount_min": 25000,
      "amount_max": null,
      "currency": "EUR",
      "risk_tier": null,
      "required_role": "chief_claims",
      "outcome": "hold",
      "rule_code": "CLM-03",
      "active": true
    }
  ],
  "field_policies": [
    { "field_path": "claimant.ssn", "mode": "hash" },
    { "field_path": "medical_notes", "mode": "evaluate_only" }
  ],
  "rules": [
    {
      "rule_id": "CLM-STAFF",
      "tool_pattern": "governed.action",
