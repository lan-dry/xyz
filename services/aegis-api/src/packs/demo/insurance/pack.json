  "authority_matrix": [
    {
      "matrix_id": "demo_ins_claim_low",
      "product": "claim_payout",
      "amount_min": 0,
      "amount_max": 2500,
      "currency": "EUR",
      "risk_tier": null,
      "required_role": null,
      "outcome": "allow",
