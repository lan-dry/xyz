# Copy to .env — credentials from Aegis Console → Provision / API keys
AEGIS_ENABLED=0
AEGIS_API_URL=http://127.0.0.1:8080
# Ingest HTTP secret (Bearer token) — not the agent id
AEGIS_INGEST_API_KEY=
AEGIS_ORGANIZATION_ID=
AEGIS_AGENT_ID=
AEGIS_KEY_ID=
# Private key (base64) for the key above — signs events cryptographically
AEGIS_SIGNING_PRIVATE_KEY_B64=
AEGIS_ACTOR_PRINCIPAL=agent:example-agent
AEGIS_CONSOLE_URL=http://localhost:3001
