# Copy to .env and fill from the Aegis console.
# Settings → API keys → ingest key
# Agents → create/open agent → agent id, key id, private key (shown once)
# Use a dedicated agent for this demo (name it for the action, e.g. Loan Decision Agent),
# not an email/invoice demo agent — case titles come from the event task, but the agent
# label still shows the agent's display name.
AEGIS_API_URL=https://api.salanor.com
AEGIS_INGEST_API_KEY=
AEGIS_ORGANIZATION_ID=
AEGIS_AGENT_ID=
AEGIS_KEY_ID=
AEGIS_SIGNING_PRIVATE_KEY_B64=
AEGIS_CONSOLE_URL=https://app.salanor.com

# Local stack instead of production:
# AEGIS_API_URL=http://127.0.0.1:8080
# AEGIS_CONSOLE_URL=http://localhost:3000
