{
  "name": "n8n-nodes-salanor-aegis",
  "version": "0.1.0",
  "description": "Salanor Aegis community nodes for n8n — record signed traces and check policies before risky steps",
  "keywords": [
    "n8n-community-node-package",
    "salanor",
    "aegis",
    "governance",
    "audit"
  ],
  "license": "MIT",
  "homepage": "https://salanor.com",
  "author": {
    "name": "Salanor",
    "email": "partners@salanor.com"
  },
