    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
