{
  "name": "n8n-nodes-salanor-aegis",
  "version": "1.0.3",
  "description": "Salanor Aegis node for n8n: check policy before risky steps and record signed traces",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "salanor",
    "aegis",
    "governance",
    "audit",
    "policy",
    "compliance"
  ],
  "license": "MIT",
  "homepage": "https://docs.salanor.com/aegis/n8n",
  "bugs": {
    "url": "https://github.com/salanor-ltd/n8n-nodes-salanor-aegis/issues"
  },
  "author": {
    "name": "Salanor",
    "email": "hello@salanor.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salanor-ltd/n8n-nodes-salanor-aegis.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SalanorAegisApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SalanorAegis/SalanorAegis.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
