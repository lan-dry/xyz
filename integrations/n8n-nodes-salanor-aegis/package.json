{
  "name": "n8n-nodes-salanor-aegis",
  "version": "0.1.0",
  "private": false,
  "description": "Salanor Aegis for n8n — Record signed traces and Check Policy before risky steps",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "salanor",
    "aegis",
    "governance",
    "audit",
    "policy"
  ],
  "license": "MIT",
  "homepage": "https://www.salanor.com",
  "author": {
    "name": "Salanor",
    "email": "partners@salanor.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lan-dry/xyz.git",
    "directory": "integrations/n8n-nodes-salanor-aegis"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
