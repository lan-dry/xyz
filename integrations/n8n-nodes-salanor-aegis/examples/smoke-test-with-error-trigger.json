{
  "name": "Aegis smoke test (Check Policy + Record Run + Error Trigger)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "amount",
              "name": "amount_usd",
              "value": 2500,
              "type": "number"
            },
            {
              "id": "recipient",
              "name": "recipient",
              "value": "vendor@example.com",
              "type": "string"
            },
            {
              "id": "summary",
              "name": "summary",
              "value": "Wire transfer to vendor (smoke test)",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "request-context",
      "name": "Request context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [360, 300]
    },
    {
      "parameters": {
        "operation": "checkPolicy",
        "organizationId": "YOUR_ORG_ID",
        "agentId": "YOUR_AGENT_ID",
        "toolName": "app.payments.transfer",
        "onDeny": "error",
        "waitForApproval": true,
        "approvalPollSeconds": 5,
        "approvalTimeoutSeconds": 300
      },
      "id": "check-policy",
      "name": "Check Policy",
      "type": "n8n-nodes-salanor-aegis.salanorAegis",
      "typeVersion": 1,
      "position": [580, 300],
      "credentials": {
        "salanorAegisApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Salanor Aegis API"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "sample_tool",
              "value": "={{ { \"name\": \"Transfer\", \"tool_name\": \"app.payments.transfer\", \"status\": \"success\" } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "simulate-payment",
      "name": "Simulate payment",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [800, 300]
    },
    {
      "parameters": {
        "operation": "recordRun",
        "businessContext": "={{ $workflow.name }}",
        "summary": "Smoke test completed",
        "runStatus": "completed",
        "nodesJson": "[]"
      },
      "id": "record-run",
      "name": "Record Run",
      "type": "n8n-nodes-salanor-aegis.salanorAegis",
      "typeVersion": 1,
      "position": [1020, 300],
      "credentials": {
        "salanorAegisApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Salanor Aegis API"
        }
      }
    },
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 520]
    },
    {
      "parameters": {
        "operation": "recordRun",
        "businessContext": "={{ $workflow.name }}",
        "summary": "Workflow failed",
        "runStatus": "failed",
        "nodesJson": "[]"
      },
      "id": "record-failed",
      "name": "Record Run (Failed)",
      "type": "n8n-nodes-salanor-aegis.salanorAegis",
      "typeVersion": 1,
      "position": [460, 520],
      "credentials": {
        "salanorAegisApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Salanor Aegis API"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Request context", "type": "main", "index": 0 }]]
    },
    "Request context": {
      "main": [[{ "node": "Check Policy", "type": "main", "index": 0 }]]
    },
    "Check Policy": {
      "main": [[{ "node": "Simulate payment", "type": "main", "index": 0 }]]
    },
    "Simulate payment": {
      "main": [[{ "node": "Record Run", "type": "main", "index": 0 }]]
    },
    "Error Trigger": {
      "main": [[{ "node": "Record Run (Failed)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
