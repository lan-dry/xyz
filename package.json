{
  "name": "salanor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/scripts/dev-all.mjs",
    "dev:web": "nx run-many -t dev --projects=@salanor/web-console,@salanor/web-docs,@salanor/web-marketing,@salanor/web-platform --parallel=4",
    "dev:api": "nx run-many -t dev --projects=aegis-api,id,insurance-api --parallel=3",
    "dev:platform": "nx run @salanor/web-platform:dev",
    "dev:core": "nx run-many -t dev --projects=@salanor/web-console,aegis-api,id --parallel=3",
    "dev:stoa": "nx run-many -t dev --projects=id,stoa-api,@salanor/web-workspace --parallel=3",
    "db:migrate:stoa": "pnpm --filter stoa-api db:migrate",
    "retention:scheduled:stoa": "pnpm --filter stoa-api retention:scheduled",
    "db:seed:stoa": "pnpm --filter stoa-api db:seed:dev",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "check:wording": "node scripts/check-no-bare-verified.mjs",
    "test": "nx run-many -t test --all",
    "db:migrate": "pnpm --filter aegis-api db:migrate",
    "db:seed:bootstrap": "pnpm --filter aegis-api db:seed:bootstrap",
    "db:local:pilot-fixture": "pnpm --filter aegis-api db:local:pilot-fixture",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:web": "prisma db push",
    "db:migrate:web": "prisma migrate dev",
    "demo:ingest": "pnpm --filter @salanor/demo-tools ingest-one-event",
    "demo:review-normal": "pnpm --filter @salanor/demo-tools ingest-review-normal",
    "demo:review-injected": "pnpm --filter @salanor/demo-tools ingest-review-injected",
    "demo:verify-chain": "pnpm --filter @salanor/demo-tools verify-chain",
    "demo:clear-cases": "pnpm --filter @salanor/demo-tools exec tsx clear-org-cases.mts",
    "demo:proxy": "pnpm --filter @salanor/demo-tools proxy-fetch",
    "demo:full-system": "pnpm --filter @salanor/demo-tools full-system",
    "pilot:e2e": "node tools/scripts/e2e-onboarding.mjs",
    "pilot:plan-limit": "pnpm --filter @salanor/demo-tools verify-plan-limit",
    "pilot:phase-a": "node tools/scripts/phase-a-api-smoke.mjs",
    "pilot:agent": "pnpm --filter @salanor/pilot-agent pilot",
    "pilot:agent:rebuild": "pnpm --filter @salanor/aegis build && pnpm --filter @salanor/pilot-agent pilot",
    "pilot:ensure-policy": "pnpm --filter @salanor/demo-tools ensure-pilot-policy",
    "pilot:ensure-approval-policy": "pnpm --filter @salanor/demo-tools ensure-pilot-approval-policy",
    "pilot:ensure-beneficiary-match-policy": "pnpm --filter @salanor/demo-tools ensure-beneficiary-match-policy",
    "pilot:agent:approval": "pnpm --filter @salanor/pilot-agent pilot:approval",
    "pilot:agent:approval:gold": "pnpm --filter @salanor/pilot-agent pilot:approval:gold",
    "pilot:agent:resume": "pnpm --filter @salanor/pilot-agent pilot:resume",
    "pilot:agent:payout": "pnpm --filter @salanor/pilot-agent pilot:payout",
    "pilot:agent:manipulated": "pnpm --filter @salanor/pilot-agent pilot:manipulated",
    "pilot:agent:data-access": "pnpm --filter @salanor/pilot-agent pilot:data-access",
    "pilot:agent:resume:payout": "pnpm --filter @salanor/pilot-agent pilot:resume:payout",
    "pilot:spine-smoke": "pnpm --filter @salanor/demo-tools pilot-spine-smoke",
    "pilot:publish-proofs": "pnpm --filter aegis-api witness:batch",
    "pilot:gate": "pnpm --filter @salanor/aegis build && pnpm --filter @salanor/aegis typecheck && pnpm --filter aegis-api typecheck && pnpm --filter @salanor/web-console typecheck && pnpm --filter @salanor/pilot-agent typecheck && pnpm --filter aegis-api test && pnpm --filter @salanor/demo-tools test",
    "sdk:conformance": "pnpm --filter @salanor/aegis build && node tools/conformance/sdk-signing.mjs && cd sdks/go && go test ./... && cd ../python && python -m pip install -q -e \".[dev]\" && python -m pytest -q",
    "conformance:src1": "pnpm --filter @salanor/aegis-sdk build && node conformance/run.mjs",
    "sdk:conformance:ts-py": "pnpm --filter @salanor/aegis build && node tools/conformance/sdk-signing.mjs && cd sdks/python && python -m pip install -q -e \".[dev]\" && python -m pytest -q",
    "pilot:reset": "node tools/scripts/pilot-reset.mjs",
    "demo:seed:northwind": "pnpm --filter aegis-api demo:seed:northwind",
    "demo:operator": "tsx tools/demo/demo-operator.mts",
    "billing:usage-backfill": "pnpm --filter billing usage:backfill",
    "dev:billing": "pnpm --filter billing dev",
    "witness:batch": "pnpm --filter aegis-signer batch",
    "transparency:publish": "pnpm --filter aegis-api publish-transparency",
    "demo:verify-inclusion": "pnpm --filter @salanor/demo-tools verify-inclusion",
    "demo:up": "node tools/demo/demo-up.mjs",
    "pilot:provision-demo-tenant": "pnpm --filter @salanor/demo-tools provision-demo-tenant",
    "pilot:seed-history": "pnpm --filter @salanor/demo-tools seed-history",
    "pilot:wipe-tenant": "pnpm --filter @salanor/demo-tools wipe-tenant",
    "pack:apply": "pnpm --filter aegis-api pack:apply",
    "demo:fresh": "node tools/demo/demo-fresh.mjs",
    "bank-simulator": "node tools/bank-simulator/server.mjs",
    "bank:up": "node tools/bank-simulator/bank-up.mjs",
    "bank:down": "node tools/bank-simulator/bank-down.mjs",
    "demo:connectors": "node tools/demo/demo-connectors.mjs",
    "test:redteam": "node tools/redteam/run.mjs",
    "demo:rehearse": "node tools/demo/demo-rehearse.mjs",
    "demo:screens": "node tools/demo/demo-screens.mjs",
    "demo:full-menu": "node tools/demo/demo-leftover-scan.mjs",
    "demo:console-check": "node tools/demo/console-check.mjs",
    "demo:runbook-walk": "node tools/demo/demo-runbook-walk.mjs",
    "demo:prove-escalation-2min": "node tools/demo/prove-escalation-2min.mjs",
    "demo:prove-cors-cookie": "node tools/demo/prove-cors-cookie.mjs",
    "docs:status-agree": "node tools/scripts/status-docs-agree.mjs",
    "check:no-demo-mode": "node tools/scripts/no-demo-mode-reintro.mjs",
    "backup": "tsx tools/backup-restore-drill/run.mts --backup",
    "restore": "tsx tools/backup-restore-drill/run.mts --restore",
    "verifier:public": "tsx tools/verifier/verify.mts",
    "aegis:verify-compliance-zip": "tsx tools/aegis-verify-compliance-zip/run.mts",
    "aegis-verify": "tsx tools/aegis-verify/cli.mts",
    "aegis-verify:pack": "node tools/aegis-verify/pack.mjs",
    "backup-restore-drill": "tsx tools/backup-restore-drill/run.mts",
    "generate:openapi-clients": "node tools/generated-clients/generate.mjs",
    "smoke:kms": "pnpm --filter aegis-api smoke:kms",
    "smoke:production": "node tools/smoke/smoke-production.mjs",
    "launch:release-staging": "node scripts/release-staging.mjs",
    "launch:restore-check": "node scripts/launch-restore-check.mjs",
    "launch:quickstarts": "pnpm --filter aegis-api exec tsx scripts/run-quickstarts.mts",
    "launch:stranger": "pnpm --filter aegis-api exec tsx scripts/run-stranger-test.mts",
    "launch:sandbox-expiry": "pnpm --filter aegis-api exec tsx src/tenants/sandbox-lifecycle-cli.ts",
    "smoke:openapi-clients": "node tools/generated-clients/smoke.mjs",
    "compliance:worker": "pnpm --filter aegis-api compliance:worker",
    "build": "nx run-many -t build --all"
  },
  "devDependencies": {
    "@nx/eslint": "21.2.0",
    "@nx/eslint-plugin": "21.2.0",
    "@nx/js": "21.2.0",
    "@nx/next": "21.2.0",
    "@nx/node": "21.2.0",
    "@nx/workspace": "21.2.0",
    "@prisma/client": "6.3.1",
    "@salanor/config": "workspace:*",
    "eslint": "^9.28.0",
    "nx": "21.2.0",
    "playwright": "^1.65.1",
    "prisma": "6.3.1",
    "typescript": "^5.8.3"
  }
}
