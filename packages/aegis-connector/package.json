{
  "name": "@salanor/aegis-connector",
  "version": "0.1.0",
  "description": "Local AEGIS-SRC1 connector: signs source events, durable outbox, forwards to Aegis",
  "type": "module",
  "bin": {
    "aegis-connector": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.js start"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": ["^build"]
      }
    }
  },
  "dependencies": {
    "@salanor/aegis-sdk": "workspace:*"
  },
  "devDependencies": {
    "@salanor/config": "workspace:*",
    "@types/node": "^22.15.21",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.0.5"
  }
}
