#!/bin/sh
# Strip Cursor agent co-author trailers (injected by Cursor Shell / cloud agents).
# Install once: git config core.hooksPath .githooks  (from repo root)
if [ -f "$1" ]; then
  sed -i.bak '/cursoragent@cursor\.com/d' "$1" 2>/dev/null || \
    sed -i '' '/cursoragent@cursor\.com/d' "$1" 2>/dev/null || true
  rm -f "$1.bak" 2>/dev/null || true
fi
