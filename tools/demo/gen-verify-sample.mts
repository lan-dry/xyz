/**
 * One-shot: generate apps/web-console verify tamper-demo sample receipt.
 * Run: pnpm --filter @salanor/demo-tools exec tsx gen-verify-sample.mts
 */
import { writeFileSync } from "node:fs";
import { resolve, dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { signEvent } from "@salanor/aegis";

const privateKeyB64 = "mqUA8ONIg7SN0gL8luCakqehaIzp8Lys6ZHMjAoBx/M=";
/** Public half of DEV_SIGNING_PRIVATE_KEY_B64 in .env.example. */
const publicKeyB64 = "y6Sn2Ycs7D9VcOXv2DR/7LhlAEizACShh3qCd6YJLPI=";
const keyId = "key-refund-operations";

const event = {
  schema_version: 1,
  event_id: "evt_northwind_tamper_demo_01",
  organization_id: "00000000-0000-4000-8000-000000000001",
  trace_id: "trc_northwind_tamper_demo",
  agent_id: "agent-refund-operations",
  key_id: keyId,
  emitted_at: "2026-10-26T12:00:00.000Z",
  actor_type: "agent" as const,
  actor_principal: "pilot-support-agent",
  action_kind: "tool_call" as const,
  tool_name: "stripe.paymentIntents.create",
  policy_decision: "deny" as const,
  payload: {
    amount_usd: 249,
    segment: "retail",
    account_type: "consumer",
    beneficiary: "customer-jordan-4410",
    note: "Northwind sample receipt for public Verify tamper demo",
  },
};

const signed = await signEvent(event, { privateKeyB64, keyId });
const out = resolve(
  dirname(fileURLToPath(import.meta.url)),
  "../../apps/web-console/src/app/verify/sample-receipt.ts",
);
const body = `/** Generated by tools/demo/gen-verify-sample.mts — do not hand-edit signature. */

export type SampleReceipt = {
  schema_version: number;
  event_id: string;
  organization_id: string;
  trace_id: string;
  agent_id: string;
  key_id: string;
  emitted_at: string;
  actor_type: string;
  actor_principal: string;
  action_kind: string;
  tool_name: string;
  policy_decision: string;
  payload: Record<string, unknown>;
  sig_alg: string;
  sig_value_b64: string;
};

export const SAMPLE_RECEIPT_PUBLIC_KEY_B64 = ${JSON.stringify(publicKeyB64)};

export const SAMPLE_RECEIPT_INTACT: SampleReceipt = ${JSON.stringify(signed, null, 2)};
`;
writeFileSync(out, body);
console.log(`Wrote ${out}`);
