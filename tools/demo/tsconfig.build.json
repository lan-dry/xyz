{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": [
    "load-env.mts",
    "demo-tenant-lib.mts",
    "connector-sources.mts",
    "tenant-wipe-lib.mts",
    "provision-demo-tenant.mts",
    "seed-history.mts",
    "wipe-tenant.mts"
  ]
}
